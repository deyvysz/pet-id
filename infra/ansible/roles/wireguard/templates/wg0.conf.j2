# Administrado por Ansible (pet-id, rol wireguard). No editar a mano.
[Interface]
Address = {{ wireguard_address }}
ListenPort = {{ wireguard_port }}
PrivateKey = {{ wireguard_server_key.content | b64decode | trim }}
{% for peer in wireguard_peers %}

[Peer]
# {{ peer.name }}
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.address }}
{% endfor %}
